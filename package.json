{
  "name": "personal-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build web",
    "docker:dev:detached": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build -d web",
    "docker:dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:db:deploy": "docker compose -f docker-compose.yml -f docker-compose.dev.yml run --rm migrate",
    "docker:db:seed": "docker compose -f docker-compose.yml -f docker-compose.dev.yml run --rm web npm run db:seed",
    "build": "next build",
    "verify": "openspec validate --all --strict && npm run test:run && npm run lint && npm run build",
    "build:clean": "node -e \"const fs=require('fs');try{fs.rmSync('.next',{recursive:true,force:true})}catch(e){if(e.code!=='ENOENT')throw e}\" && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.10.1",
    "next": "^16.2.6",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
